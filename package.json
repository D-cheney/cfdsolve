{
  "name": "flowforge-cfd-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node scripts/copy-meshing-runtime.mjs",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "deploy:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-local.ps1",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status-local.ps1",
    "audit:prod": "npm audit --omit=dev",
    "typecheck": "nuxt typecheck",
    "test:formula": "node --experimental-strip-types tests/formula-converter.test.mjs",
    "test:modelica": "tsx tests/modelica-workbench.test.mjs",
    "test:solvers": "tsx tests/solvers.test.mjs",
    "test:cfd-workbench": "tsx tests/cfd-workbench.test.mjs",
    "test:sketch": "tsx tests/sketch-geometry.test.mjs",
    "test:modeling": "tsx tests/modeling-core.test.mjs",
    "test:meshing": "tsx tests/meshing-core.test.mjs",
    "check:meshing-runtime": "node scripts/check-meshing-runtime.mjs",
    "test:lab": "tsx tests/simulation-lab.test.mjs",
    "test:database": "tsx tests/database-workspace.test.mjs",
    "test:knowledge": "tsx tests/knowledge-importer.test.mjs",
    "test:cae-knowledge": "tsx tests/cae-knowledge.test.mjs",
    "test:knowledge-catalog": "tsx tests/knowledge-catalog.test.mjs",
    "test:knowledge-expansion": "tsx tests/knowledge-expansion.test.mjs",
    "db:init": "tsx scripts/init-database.mjs",
    "db:check": "tsx scripts/check-database.mjs",
    "db:backup": "tsx scripts/backup-database.mjs",
    "knowledge:validate": "tsx scripts/import-knowledge.mjs --dry-run",
    "knowledge:import": "tsx scripts/import-knowledge.mjs",
    "knowledge:sync": "tsx scripts/import-knowledge.mjs templates/knowledge",
    "knowledge:sync:articles": "tsx scripts/sync-knowledge-articles.mjs",
    "knowledge:reorganize": "node scripts/reorganize-knowledge-topics.mjs --apply",
    "generate": "nuxt generate",
    "preview": "nuxt preview"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.2",
    "@salusoft89/planegcs": "^1.2.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.3.0",
    "nuxt": "^3.21.0",
    "opencascade.js": "^2.0.0-beta.b5ff984",
    "pinia": "^3.0.3",
    "polygon-clipping": "^0.15.7",
    "sanitize-html": "^2.17.6",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.9"
  }
}
