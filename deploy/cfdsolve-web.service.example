[Unit]
Description=CFD菜鸟网站服务
After=network.target cfdsolve-solver.service
Wants=cfdsolve-solver.service

[Service]
Type=simple
User=cfdsolve
Group=cfdsolve
WorkingDirectory=/opt/cfdsolve
Environment=NODE_ENV=production
Environment=CFD_DATA_ROOT=/var/lib/cfdsolve
Environment=PORT=4317
ExecStart=/usr/bin/node /opt/cfdsolve/.output/server/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cfdsolve

[Install]
WantedBy=multi-user.target
